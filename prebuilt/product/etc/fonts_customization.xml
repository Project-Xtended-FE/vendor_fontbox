<?xml version="1.0" encoding="utf-8"?>
<fonts-modification version="1">
    <!-- Beauty -->
    <family customizationType="new-named-family" name="beauty">
        <font weight="400" style="normal">Beauty.ttf</font>
    </family>
    <alias name="oduda-semi-bold" to="beauty" weight="600" />
    <alias name="oduda-bold" to="beauty" weight="700" />
    <alias name="times" to="beauty" />
    <alias name="times new roman" to="beauty" />
    <alias name="palatino" to="beauty" />
    <alias name="georgia" to="beauty" />
    <alias name="baskerville" to="beauty" />
    <alias name="goudy" to="beauty" />
    <alias name="fantasy" to="beauty" />
    <alias name="ITC Stone Serif" to="beauty" />

    <!-- Cool Jazz -->
    <family customizationType="new-named-family" name="cooljazz">
        <font weight="300" style="normal">Cooljazz.ttf</font>
    </family>
    <alias name="cooljazz-light" to="cooljazz" weight="300" />
 
    <!-- Roboto -->
    <family customizationType="new-named-family" name="roboto">
        <font weight="400" style="normal">Roboto-Regular.ttf</font>
    </family>

    <!-- Roboto Flex -->
    <family customizationType="new-named-family" name="roboto-flex">
        <font supportedAxes="wght">RobotoFlex-Regular.ttf
          <axis tag="wdth" stylevalue="100" />
        </font>
    </family>

    <family name="SpaceGrotesk" customizationType="new-named-family">
        <font weight="300" style="normal" postScriptName="SpaceGrotesk-Light">
            SpaceGrotesk-Light.ttf
        </font>

        <font weight="400" style="normal" postScriptName="SpaceGrotesk-Regular">
            SpaceGrotesk-Regular.ttf
        </font>

        <font weight="500" style="normal" postScriptName="SpaceGrotesk-Medium">
            SpaceGrotesk-Medium.ttf
        </font>

        <font weight="600" style="normal" postScriptName="SpaceGrotesk-SemiBold">
            SpaceGrotesk-SemiBold.ttf
        </font>

        <font weight="700" style="normal" postScriptName="SpaceGrotesk-Bold">
            SpaceGrotesk-Bold.ttf
        </font>
    </family>

    <family customizationType="new-named-family" name="sanfrancisco-sb-round-clock">
      <font weight="300" style="normal">SFPro-SemiboldRounded.otf</font>
    </family>

    <family customizationType="new-named-family" name="subway">
